#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

PYTHON_BIN=""
for candidate in python python3; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 12))' >/dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done
if [ -z "$PYTHON_BIN" ]; then
    echo "ERROR: Python 3.12+ is required to run scripts/check-repository.py." >&2
    exit 1
fi

"$PYTHON_BIN" "$REPO_ROOT/scripts/check-repository.py"

if ! command -v pwsh >/dev/null 2>&1; then
    echo "ERROR: PowerShell 7 (pwsh) is required to run scripts/check-powershell.ps1." >&2
    echo "Install PowerShell 7 or run checks in an environment with pwsh before committing." >&2
    exit 1
fi

pwsh -NoProfile -File "$REPO_ROOT/scripts/check-powershell.ps1"
